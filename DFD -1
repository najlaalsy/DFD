<mxfile>
  <diagram name="DFD Level 1 Shopee Mall">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- External Entities -->
        <mxCell id="cust" value="Customer" style="shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="merchant" value="Merchant" style="shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="payment" value="Payment Gateway" style="shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="750" y="250" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ekspedisi" value="Ekspedisi" style="shape=rectangle;" vertex="1" parent="1">
          <mxGeometry x="750" y="400" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Processes -->
        <mxCell id="p1" value="1.0 Kelola Pesanan" style="ellipse;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p2" value="2.0 Kelola Pembayaran" style="ellipse;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="3.0 Kelola Pengiriman" style="ellipse;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Data Flows -->
        <mxCell id="f1" value="Data Pesanan" edge="1" parent="1" source="cust" target="p1"/>
        <mxCell id="f2" value="Detail Pesanan" edge="1" parent="1" source="p1" target="merchant"/>
        <mxCell id="f3" value="Konfirmasi" edge="1" parent="1" source="merchant" target="p1"/>
        <mxCell id="f4" value="Data Pembayaran" edge="1" parent="1" source="p1" target="p2"/>
        <mxCell id="f5" value="Proses Bayar" edge="1" parent="1" source="p2" target="payment"/>
        <mxCell id="f6" value="Status Bayar" edge="1" parent="1" source="payment" target="p2"/>
        <mxCell id="f7" value="Permintaan Kirim" edge="1" parent="1" source="p1" target="p3"/>
        <mxCell id="f8" value="Request Kirim" edge="1" parent="1" source="p3" target="ekspedisi"/>
        <mxCell id="f9" value="Status Kirim" edge="1" parent="1" source="ekspedisi" target="p3"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
